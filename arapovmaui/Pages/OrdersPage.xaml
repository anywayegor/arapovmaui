<?xml version="1.0" encoding="utf-8" ?>

<ContentPage

    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"

    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"

    x:Class="arapovmaui.Pages.OrdersPage"

    Title="Заказы">

    <Grid Padding="10">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <Button
                Text="Назад"
                Clicked="BackButton_Clicked"
                BackgroundColor="#00FA9A"
                TextColor="Black"/>

        <Button

            Grid.Row="0"

            x:Name="AddOrderButton"

            Text="Добавить заказ"

            Clicked="AddOrderButton_Clicked"
            
            BackgroundColor="#7FFF00"
            TextColor="Black"/>

        <CollectionView

            Grid.Row="1"

            x:Name="OrdersCollection">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Frame

                        Margin="5"

                        Padding="10"

                        BorderColor="Black">

                        <Frame.GestureRecognizers>

                            <TapGestureRecognizer

                                Tapped="OrderTapped"/>

                        </Frame.GestureRecognizers>

                        <Grid ColumnDefinitions="*,120">

                            <VerticalStackLayout

                                Grid.Column="0"

                                Spacing="3">

                                <Label

                                    Text="{Binding IdOrder, StringFormat='Заказ №{0}'}"

                                    FontAttributes="Bold"

                                    FontSize="16"/>

                                <Label

                                    Text="{Binding Status, StringFormat='Статус: {0}'}"/>

                                <Label

                                    Text="{Binding DeliveryStation}"

                                    LineBreakMode="WordWrap"/>

                                <Label

                                    Text="{Binding OrderDate, StringFormat='Дата заказа: {0:dd.MM.yyyy}'}"/>

                            </VerticalStackLayout>

                            <Frame

                                Grid.Column="1"

                                Margin="10,0,0,0"

                                Padding="5"

                                BorderColor="Black">

                                <VerticalStackLayout

                                    VerticalOptions="Center">

                                    <Label

                                        Text="Дата доставки"

                                        HorizontalOptions="Center"

                                        FontSize="12"/>

                                    <Label

                                        Text="{Binding DeliveryDate, StringFormat='{0:dd.MM.yyyy}'}"

                                        FontAttributes="Bold"

                                        HorizontalOptions="Center"/>

                                </VerticalStackLayout>

                            </Frame>

                        </Grid>

                    </Frame>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>